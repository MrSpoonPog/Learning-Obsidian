{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/tools/dashboard/session-start-summary.mjs",
            "timeout": 15,
            "statusMessage": "Loading Frontier summary..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/tools/sync/session-end.mjs",
            "timeout": 30,
            "statusMessage": "Auto-syncing learning session to GitHub..."
          }
        ]
      }
    ]
  }
}
